{
  "schemaVersion": 1,
  "target": ".",
  "output": "docs/codebase-intelligence",
  "include": [
    "**/*"
  ],
  "exclude": [],
  "depth": "standard",
  "specialists": [
    "correctness",
    "performance",
    "security",
    "testing",
    "maintainability",
    "architecture",
    "dependencies",
    "model-review"
  ],
  "concurrency": 4,
  "budgets": {
    "maxFiles": 30000,
    "maxFileBytes": 1048576,
    "maxTotalBytes": 150000000,
    "maxRunSeconds": 600,
    "contextTokens": 12000,
    "maxModelCalls": 8,
    "toolTimeoutMs": 15000
  },
  "tools": {
    "git": true,
    "python": true
  },
  "privacy": {
    "sendSource": false,
    "redact": true
  },
  "network": {
    "enabled": false,
    "allowedOrigins": []
  },
  "model": {
    "provider": "none",
    "name": "",
    "baseUrl": "",
    "apiKeyEnv": "MODEL_API_KEY",
    "timeoutMs": 30000,
    "maxRetries": 1
  },
  "weights": {
    "severity": 5,
    "confidence": 2,
    "security": 2,
    "effort": 1,
    "risk": 1
  },
  "retention": 20,
  "verbosity": "detailed",
  "resume": "reuse-unchanged"
}
